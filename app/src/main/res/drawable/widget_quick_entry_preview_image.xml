<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="start|center_vertical"
        android:left="8dp">
        <shape android:shape="oval">
            <solid android:color="#137A4C" />
        </shape>
    </item>
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="end|center_vertical"
        android:right="8dp">
        <shape android:shape="oval">
            <solid android:color="#BF4310" />
        </shape>
    </item>
</layer-list>
